# Public URL of the deployed site (used for canonical URL, Open Graph, sitemap).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Formspree form ID (the part after https://formspree.io/f/).
# Leave empty to fall back to a mailto: link.
NEXT_PUBLIC_FORMSPREE_ID=
